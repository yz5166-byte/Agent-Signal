# 用法：复制本文件为 .env，再把值填进去。
# .env 已被 .gitignore 忽略，绝不会被提交到 GitHub。

# ---- LLM：AIHubMix（OpenAI 兼容接口）----
LLM_API_KEY=
LLM_BASE_URL=https://aihubmix.com/v1
LLM_MODEL_ID=

# ---- GitHub API（可选：填了能把限额从 60 次/小时提到 5000 次/小时）----
GITHUB_TOKEN=

# ---- 邮件投递（SMTP，留空则跳过发信，只写本地文件）----
# Gmail 必须用「应用专用密码」，不能用账号密码：
#   1. 先开两步验证        myaccount.google.com/security
#   2. 再生成应用专用密码  myaccount.google.com/apppasswords
#   3. 得到 16 位字符，填进 SMTP_PASSWORD 时把空格去掉
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=
